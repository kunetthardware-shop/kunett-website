# KUNETT Hardware - Hostinger LiteSpeed / Apache Performance, SEO & AI Agent Rules
AddType text/markdown;charset=utf-8 .md .markdown
AddType application/json;charset=utf-8 .json

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Expose RFC 5785 .well-known directory (for MCP server card, SSL, etc.)
  RewriteRule ^\.well-known/ - [L]

  # Clean URL rewrites for About, Terms, and Contact
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^terms/?$ terms.html [L]
  RewriteRule ^contact/?$ contact.html [L]

  # Serve Markdown representation when an agent requests Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^(index\.html)?$ markdown.php [L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.kunetthardware\.com [NC]
  RewriteRule ^(.*)$ https://kunetthardware.com/$1 [L,R=301]

  # 301 Redirect /index.html to canonical root / (only for browser HTML requests)
  RewriteCond %{HTTP:Accept} !text/markdown [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://kunetthardware.com/ [R=301,L]
</IfModule>

# Goal 4: Enforce text/markdown MIME type for Markdown representations
<FilesMatch "(index|llms)\.(md|txt)$">
  ForceType "text/markdown; charset=utf-8"
  Header set Content-Type "text/markdown; charset=utf-8"
</FilesMatch>

<Files "server-card.json">
  ForceType "application/json; charset=utf-8"
  Header set Content-Type "application/json; charset=utf-8"
</Files>
<Files "mcp.json">
  ForceType "application/json; charset=utf-8"
  Header set Content-Type "application/json; charset=utf-8"
</Files>

# Goal 5: Emit RFC 8288 Link Headers & Content Negotiation Signals for AI Agents
<IfModule mod_headers.c>
  Header always set Link '</llms.txt>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby", <https://kunetthardware.com/llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"'
  Header set Link '</llms.txt>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby", <https://kunetthardware.com/llms.txt>; rel="alternate"; type="text/markdown", </.well-known/mcp/server-card.json>; rel="service-desc"'
  Header append Vary "Accept"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# GZIP / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript text/markdown application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for Fast PageSpeed Scores
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/markdown "access plus 1 hour"
</IfModule>
