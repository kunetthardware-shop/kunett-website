# KUNETT Hardware - Hostinger LiteSpeed / Apache Performance & SEO Rules
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Allow RFC 5785 .well-known directory (for MCP server card, SSL, etc.)
  RewriteRule ^\.well-known/ - [L]

  # Serve Markdown representation when an agent requests Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^(index\.html)?$ llms.txt [L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.kunetthardware\.com [NC]
  RewriteRule ^(.*)$ https://kunetthardware.com/$1 [L,R=301]

  # 301 Redirect /index.html to canonical root / (only for normal browser requests, not markdown)
  RewriteCond %{HTTP:Accept} !text/markdown [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://kunetthardware.com/ [R=301,L]
</IfModule>

# MIME Types for Agent Readiness
<Files "llms.txt">
  ForceType "text/markdown; charset=utf-8"
</Files>
<Files "llms-full.txt">
  ForceType "text/markdown; charset=utf-8"
</Files>
<Files "server-card.json">
  ForceType "application/json; charset=utf-8"
</Files>
<Files "mcp.json">
  ForceType "application/json; charset=utf-8"
</Files>

# RFC 8288 Link Headers & Content Negotiation Signals for AI Agents
<IfModule mod_headers.c>
  Header always set Link '<https://kunetthardware.com/llms.txt>; rel="alternate"; type="text/markdown", <https://kunetthardware.com/.well-known/mcp/server-card.json>; rel="service-desc"'
  Header append Vary "Accept"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# GZIP / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript text/markdown application/javascript application/json image/svg+xml
</IfModule>

# Browser Caching for Fast PageSpeed Scores
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/markdown "access plus 1 hour"
</IfModule>